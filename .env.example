# ============================================================================
# OAUTH CONFIGURATION FOR SOCIAL MEDIA PLATFORMS
# ============================================================================

# ============================================================================
# TIKTOK CONFIGURATION
# ============================================================================
# Lấy từ: https://developers.tiktok.com/
# Cần:
#   - Client ID (App ID)
#   - Client Secret
#   - Redirect URI (phải match với backend)
# Dùng để: Post video lên TikTok
TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:8101/api/social/oauth/tiktok/callback

# ============================================================================
# FACEBOOK CONFIGURATION
# ============================================================================
# Lấy từ: https://developers.facebook.com/
# Cần:
#   - App ID (Client ID)
#   - App Secret (Client Secret)
#   - Redirect URI (phải match với backend)
# Lưu ý: Sẽ lấy Page ID + Page Access Token từ OAuth flow
# Dùng để: Post video lên Facebook Page
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:8101/api/social/oauth/facebook/callback

# ============================================================================
# YOUTUBE CONFIGURATION
# ============================================================================
# Lấy từ: https://console.cloud.google.com/
# Cần:
#   - Client ID (OAuth 2.0 Client ID)
#   - Client Secret
#   - Redirect URI (phải match với backend)
# Dùng để: Upload video lên YouTube
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8101/api/social/oauth/youtube/callback

# ============================================================================
# INSTAGRAM CONFIGURATION
# ============================================================================
# Lấy từ: https://developers.facebook.com/ (dùng Facebook Developer)
# Cần:
#   - App ID (Client ID)
#   - App Secret (Client Secret)
#   - Redirect URI (phải match với backend)
# Lưu ý: Sẽ lấy Instagram Business Account ID + Access Token từ OAuth flow
# Dùng để: Post video lên Instagram
INSTAGRAM_CLIENT_ID=your_instagram_app_id
INSTAGRAM_CLIENT_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8101/api/social/oauth/instagram/callback

# ============================================================================
# FACEBOOK PAGE (AUTO-POST / SCHEDULER)
# ============================================================================
# Token vĩnh viễn của Fanpage, dùng cho tính năng Social Block (đăng/lên lịch).
# Backend tự động import account này khi khởi động (xem main.py).
# Hướng dẫn lấy: xem README.md mục "Tích hợp Fanpage Facebook".
FB_PAGE__ID=your_facebook_page_id
FB_PAGE__ACCESS_TOKEN=your_facebook_page_permanent_token

# ============================================================================
# FIREBASE AUTH (đăng nhập Google + giới hạn thiết bị)
# ============================================================================
# Đường dẫn tới file service account JSON tải từ Firebase Console.
# Nếu không có file này, backend chạy ở chế độ mock auth (chỉ dùng để dev).
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json

# Giới hạn email/domain được phép đăng nhập (để trống = cho phép tất cả).
# Phân tách bằng dấu phẩy. Ví dụ: a@gmail.com,b@gmail.com
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# ============================================================================
# FLOWBOARD CORE (cổng, database, storage)
# ============================================================================
# Database dùng SQLite, được điều khiển qua các biến FLOWBOARD_* dưới đây
# (KHÔNG dùng DATABASE_URL). Mặc định: <repo>/storage/flowboard.db
FLOWBOARD_STORAGE=storage
# FLOWBOARD_DB=storage/flowboard.db

# Cổng & host (mặc định đã hợp lý, chỉ đổi nếu bị trùng cổng)
FLOWBOARD_HTTP_PORT=8101
FLOWBOARD_WS_HOST=127.0.0.1
FLOWBOARD_EXT_WS_PORT=9223

# ============================================================================
# AI / LLM (planner + sinh prompt)
# ============================================================================
# Backend gọi AI qua CLI (Claude Code / Gemini CLI / Codex), KHÔNG cần API key ở đây
# (API key được lưu qua secrets store trong app). Chỉ override model nếu muốn:
FLOWBOARD_PLANNER_MODEL=claude-sonnet-4-6
# "auto" = dùng CLI nếu có, không thì mock | "cli" = bắt buộc CLI | "mock" = luôn mock
FLOWBOARD_PLANNER_BACKEND=auto
# FLOWBOARD_CLAUDE_MODEL=
# FLOWBOARD_GEMINI_MODEL=
# FLOWBOARD_OPENAI_MODEL=
# FLOWBOARD_SECRETS_PATH=

# ============================================================================
# TEXT-TO-SPEECH (lồng tiếng thuyết minh)
# ============================================================================
# TTS_MODEL=
# TTS_SAMPLE_RATE=24000
# TTS_PYTHON_BIN=

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO

